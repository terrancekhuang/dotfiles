#!/bin/bash

while true; do
    output=$(natpmpc -a 1 0 udp 60 -g 10.2.0.1 2>&1 && natpmpc -a 1 0 tcp 60 -g 10.2.0.1 2>&1)
    if [ $? -eq 0 ]; then
        echo "$output" | grep -oP 'Mapped public port \K\d+' | head -1
    else
        printf "%s\nERROR with natpmpc command\n" "$(date)" >&2
        break
    fi
    sleep 45
done

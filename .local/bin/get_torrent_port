#!/bin/bash
#
# Discover the port forwarded to us by the ProtonVPN gateway (NAT-PMP) and print
# it to stdout whenever it changes. Nothing else — no firewall, no torrent client.
#
# Diagnostics go to stderr, so stdout is a clean stream of port numbers. Renews
# the 60s NAT-PMP lease every loop; runs until killed.
#
# Compose with set_torrent_port to actually apply the port, e.g.:
#     get_torrent_port | while read -r p; do set_torrent_port "$p"; done

VPN_GATEWAY="10.2.0.1"

log()  { printf "%s: %s\n" "$(date)" "$*" >&2; }
warn() { printf "%s: WARNING: %s\n" "$(date)" "$*" >&2; }
err()  { printf "%s: ERROR: %s\n" "$(date)" "$*" >&2; }

get_mapped_port() {
    local proto=$1
    natpmpc -a 1 0 "$proto" 60 -g "$VPN_GATEWAY" 2>&1 |
        grep -oP 'Mapped public port \K\d+' |
        head -1
}

LAST_PORT=""

while true; do
    UDP_PORT=$(get_mapped_port udp)
    TCP_PORT=$(get_mapped_port tcp)

    if ! [[ "$UDP_PORT" =~ ^[0-9]+$ ]] || ! [[ "$TCP_PORT" =~ ^[0-9]+$ ]]; then
        err "natpmpc failed or port could not be parsed (udp='$UDP_PORT' tcp='$TCP_PORT')"
        sleep 45
        continue
    fi

    if [ "$UDP_PORT" != "$TCP_PORT" ]; then
        warn "UDP port ($UDP_PORT) and TCP port ($TCP_PORT) differ — using UDP port"
    fi

    PORT="$UDP_PORT"

    if [ "$PORT" != "$LAST_PORT" ]; then
        log "Port changed: ${LAST_PORT:-<none>} -> $PORT"
        printf '%s\n' "$PORT"
        LAST_PORT="$PORT"
    fi

    sleep 45
done

#!/bin/bash
while getopts "F:" opt; do
    case $opt in
        F) delimiter="$OPTARG" ;;
        \?) echo "Usage: $0 [-F delimiter] [file]" >&2; exit 1 ;;
    esac
done
shift $((OPTIND-1))

awk -v delim="${delimiter:-}" '
BEGIN {
    if (delim != "") FS = delim
}

{
    row_cols[NR] = NF
    for (i = 1; i <= NF; i++) {
        cell[NR, i] = $i
        w = length($i)
        if (w > col_w[i]) col_w[i] = w
    }
}

function print_row(r,    i, sep) {
    sep = (delim != "") ? delim : " "
    for (i = 1; i <= row_cols[r]; i++) {
        printf "%-*s%s", col_w[i], cell[r, i], (i < row_cols[r]) ? sep : "\n"
    }
}

END {
    # Ensure each column is wide enough to hold its column number
    for (i in col_w)
        if (length(i) > col_w[i]) col_w[i] = length(i)

    # Print header of column numbers
    sep = (delim != "") ? delim : " "
    for (i = 1; i <= row_cols[1]; i++)
        printf "%-*s%s", col_w[i], i, (i < row_cols[1]) ? sep : "\n"

    # Print data rows
    for (r = 1; r <= NR; r++)
        print_row(r)
}
' "${1:-/dev/stdin}"

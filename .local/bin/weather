#!/bin/bash

root="https://api.weather.gov"
header="Accept: application/geo+json"
cache_dir="$HOME/.cache/weather"
location_cache="$cache_dir/location.json"
no_cache=false
verbose=false
zip=

usage() { echo "usage: weather [-v|--verbose] [--no-cache] [-z|--zip ZIP]" >&2; exit 2; }

while (($#)); do
    case $1 in
    --no-cache) no_cache=true ;;
    -v | --verbose) verbose=true ;;
    -z | --zip) [[ -n $2 ]] || usage; zip=$2; shift ;;
    --zip=*) zip=${1#*=} ;;
    *) usage ;;
    esac
    shift
done

mkdir -p "$cache_dir"

trap 'rm -f "$tmp_stations"' EXIT

cache_expired_minutes() {
    [[ ! -f "$1" || -n $(find "$1" -mmin +${2:-30} 2>/dev/null) ]]
}

# Write to cache only on success, so a failed/404 fetch never poisons it.
fetch() {
    local out=$1 tmp
    shift
    tmp=$(mktemp "$out.XXXX") && curl -sf "$@" >"$tmp" && [[ -s $tmp ]] && mv "$tmp" "$out" || rm -f "$tmp"
}

cache_expired() {
    cache_expired_minutes "$1" $((30 * 1440))
}

# 1. Location: --zip if given, else IP geolocation (both cached 30 days)
if [[ -n $zip ]]; then
    [[ $zip =~ ^([0-9]{5})(-[0-9]{4})?$ ]] || { echo "weather: --zip must be a 5-digit US ZIP code" >&2; exit 2; }
    zip=${BASH_REMATCH[1]}
    source="ZIP $zip"
    zip_cache="$cache_dir/zip-$zip.json"
    if $no_cache || cache_expired "$zip_cache"; then
        fetch "$zip_cache" --max-time 5 "https://api.zippopotam.us/us/$zip"
    fi
    IFS=$'\t' read -r latitude longitude < <(jq -r '.places[0] | [.latitude, .longitude] | @tsv' "$zip_cache" 2>/dev/null)
    [[ -n $latitude && -n $longitude ]] || { echo "weather: can't look up ZIP $zip (unknown ZIP or zippopotam.us unreachable)" >&2; exit 1; }
else
    source="IP"
    if $no_cache || cache_expired "$location_cache"; then
        fetch "$location_cache" --max-time 3 https://ipinfo.io/json
    fi
    IFS=, read -r latitude longitude < <(jq -r '.loc // empty' "$location_cache" 2>/dev/null)
    [[ -n $latitude && -n $longitude ]] || { echo "weather: can't determine location" >&2; exit 1; }
fi
# NWS 301-redirects coordinates with more than 4 decimals.
printf -v latitude %.4f "$latitude"
printf -v longitude %.4f "$longitude"

# Everything below depends on location, so cache it per location.
loc_dir="$cache_dir/$latitude,$longitude"
mkdir -p "$loc_dir"
points_cache="$loc_dir/points.json"
forecast_cache="$loc_dir/forecast.json"
obs_cache="$loc_dir/obs.json"

# 2. Points (cached 30 days)
if $no_cache || cache_expired "$points_cache"; then
    fetch "$points_cache" --max-time 5 "$root/points/$latitude,$longitude" -H "$header"
fi
IFS=$'\t' read -r obsStationsUrl forecastUrl < <(jq -r '
    [.properties.observationStations, (.properties.forecast + "?units=si")] | @tsv
' "$points_cache" 2>/dev/null)
[[ -n $obsStationsUrl ]] || { rmdir "$loc_dir" 2>/dev/null; echo "weather: NWS points lookup failed (NWS only covers the US)" >&2; exit 1; }

# 3. Forecast (cached 30 min)
tmp_stations=$(mktemp)

if $no_cache || cache_expired_minutes "$forecast_cache" 30; then
    fetch "$forecast_cache" --max-time 10 "$forecastUrl" -H "$header" &
fi
curl -s --max-time 10 "$obsStationsUrl" -H "$header" >"$tmp_stations" &
wait

# 4. Observation (cached 10 min)
stationId=$(jq -r '.features[0].properties.stationIdentifier' "$tmp_stations")
if $no_cache || cache_expired_minutes "$obs_cache" 10; then
    fetch "$obs_cache" --max-time 10 -H "$header" "$root/stations/$stationId/observations/latest"
fi

# NWS sometimes nulls a QC-flagged field even though the raw METAR still
# carries the reading (e.g. temperature qualityControl "Z"); fall back to
# the METAR temperature group (TsTTTsTdTdTd) in that case.
obsLatest=$(jq -r '
    .properties.temperature.value //
    ( (.properties.rawMessage // "")
    | capture("T(?<sign>[01])(?<tenths>[0-9]{3})[01][0-9]{3}")
    | (if .sign == "1" then -1 else 1 end) * (.tenths | tonumber) / 10
    ) // "null"
' "$obs_cache")
forecastDescription=$(jq -r '.properties.periods[0].detailedForecast' "$forecast_cache")

if $verbose; then
    IFS=$'\t' read -r place grid < <(jq -r '.properties
        | [(.relativeLocation.properties | "\(.city), \(.state)"), "\(.gridId) \(.gridX),\(.gridY)"] | @tsv' "$points_cache")
    IFS=$'\t' read -r stationName obsTime < <(jq -r '.properties | [.stationName, .timestamp] | @tsv' "$obs_cache")
    # Great-circle (haversine) distance from our point to the station.
    stationDist=$(jq -r --argjson la "$latitude" --argjson lo "$longitude" '
        def rad: . * 3.141592653589793 / 180;
        .features[0].geometry.coordinates as [$x, $y]
        | (($y - $la) | rad) as $dy | (($x - $lo) | rad) as $dx
        | (($dy / 2 | sin) * ($dy / 2 | sin)
           + ($la | rad | cos) * ($y | rad | cos) * ($dx / 2 | sin) * ($dx / 2 | sin)) as $h
        | 6371 * 2 * ($h | sqrt | asin) | . * 10 | round / 10
    ' "$tmp_stations" 2>/dev/null)
    printf 'Location: %s (%s,%s) via %s\n' "$place" "$latitude" "$longitude" "$source"
    printf 'Station:  %s %s%s\n' "$stationId" "$stationName" "${stationDist:+ ($stationDist km away)}"
    printf 'Observed: %s\n' "$(date -d "$obsTime" '+%a %b %-d, %-I:%M %p %Z' 2>/dev/null || echo "$obsTime")"
    printf 'Forecast: NWS grid %s\n\n' "$grid"
fi

printf "%s°C\n" "$obsLatest" | fmt -w 80
printf "%s\n" "$forecastDescription" | fmt -w 80
